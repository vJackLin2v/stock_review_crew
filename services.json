{
    "services":  {
                     "backend":  {
                                     "type":  "uvicorn",
                                     "cwd":  ".",
                                     "cmd":  [
                                                 ".venv/Scripts/python.exe",
                                                 "-m",
                                                 "uvicorn",
                                                 "backend.main:app",
                                                 "--host",
                                                 "127.0.0.1",
                                                 "--port",
                                                 "{port}"
                                             ],
                                     "port":  8501,
                                     "health":  {
                                                    "url":  "http://127.0.0.1:{port}/api/health",
                                                    "timeout":  40
                                                }
                                 },
                     "frontend":  {
                                      "type":  "vite",
                                      "cwd":  "frontend",
                                      "cmd":  [
                                                  "npm",
                                                  "run",
                                                  "dev",
                                                  "--",
                                                  "--port",
                                                  "{port}",
                                                  "--host",
                                                  "127.0.0.1"
                                              ],
                                      "port":  5174,
                                      "purpose":  "frontend",
                                      "health":  {
                                                     "url":  "http://127.0.0.1:{port}",
                                                     "timeout":  60
                                                 }
                                  },
                     "tunnel":  {
                                    "origin":  "http://127.0.0.1:8501",
                                    "health":  {
                                                   "timeout":  30
                                               },
                                    "type":  "tunnel"
                                }
                 }
}
